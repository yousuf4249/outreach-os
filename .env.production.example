# ============================================================
# Weblinx Outreach OS – Production Environment Configuration
# Target: https://outreach.weblinxsolution.com
# Company: Weblinx Solution (https://weblinxsolution.com)
# ============================================================

# ── Domain & HTTPS (Caddy Automatic SSL) ─────────────────────
# Point your DNS 'outreach' A record to your Hostinger VPS IPv4.
# Caddy will automatically issue and renew a trusted Let's Encrypt SSL certificate.
CADDY_HOST=outreach.weblinxsolution.com
BASE_URL=https://outreach.weblinxsolution.com

# ── PostgreSQL Database ──────────────────────────────────────
# Credentials for the dedicated postgres container
POSTGRES_USER=weblinx
POSTGRES_PASSWORD=weblinx_secure_production_pass_2026
POSTGRES_DB=weblinx_outreach

# Async connection string automatically populated by Docker Compose:
# DATABASE_URL=postgresql+asyncpg://weblinx:weblinx_secure_production_pass_2026@db:5432/weblinx_outreach

# ── Application Secrets & Security ──────────────────────────
# Secret key for JWT session encryption and credential protection.
# Generate a random 64-character hex key using: openssl rand -hex 32
JWT_SECRET_KEY=change_me_to_a_long_random_64_character_hex_secret_string

# ── Google Workspace / Gmail OAuth2 ─────────────────────────
# Enable OAuth2 authentication for connecting Google Workspace and Gmail inboxes.
# In Google Cloud Console:
# Authorized redirect URI: https://outreach.weblinxsolution.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft 365 / Outlook OAuth2 ──────────────────────────
# Enable OAuth2 authentication for connecting Microsoft 365 and Outlook inboxes.
# In Microsoft Azure Portal (App Registrations):
# Redirect URI (Web): https://outreach.weblinxsolution.com/api/auth/office365/callback
OFFICE365_CLIENT_ID=
OFFICE365_CLIENT_SECRET=
OFFICE365_TENANT_ID=common

# ── CORS Origins ─────────────────────────────────────────────
CORS_ORIGINS=https://outreach.weblinxsolution.com,https://weblinxsolution.com

# ── Backup Configuration ────────────────────────────────────
QUICKLY_LOCAL_DISK_BACKUPS=1

# ── Telemetry (Opt-out) ─────────────────────────────────────
QUICKLY_TELEMETRY=false
